# ============================================================================
# SUPER CROWN FOUNDATION — GOOGLE SHEETS & WHATSAPP INTEGRATION CONFIGURATION
# ============================================================================

# Target Google Spreadsheet ID
GOOGLE_SHEETS_SPREADSHEET_ID=1CrvoG0smYI1YEJOvlQ1nvXeQxrUfua20iHbIPrD_WyE

# OPTION 1: Google Cloud Service Account (Google Sheets API v4)
# 1. Enable Google Sheets API in your Google Cloud Console.
# 2. Create a Service Account and generate a JSON Key.
# 3. Share the Google Spreadsheet (ID above) with the service account email as "Editor".
# 4. Copy the client_email and private_key from the JSON key file into these variables:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# OPTION 2: Google Apps Script Web App Webhook (Alternative 1-click method)
# If using Google Apps Script deployed directly on the spreadsheet:
# GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec

# WhatsApp Destination Phone Number (Country code + phone without + or symbols)
NEXT_PUBLIC_WHATSAPP_NUMBER=919600151377

